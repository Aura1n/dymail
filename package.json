{
  "name": "dymail",
  "productName": "Dymail",
  "version": "1.4.1",
  "description": "Unified desktop mail client",
  "main": "src/main/main.js",
  "author": "Dymail",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icon.ps1 && node scripts/make-ico.js",
    "test": "node scripts/test.js",
    "test:ui": "node scripts/run-ui-check.js",
    "pack": "node scripts/build.js dir",
    "build:dir": "node scripts/build.js dir",
    "build:portable": "node scripts/build.js portable",
    "build:setup": "node scripts/build.js setup",
    "dist": "node scripts/build.js all",
    "clean": "node scripts/clean.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.3",
    "capacitor-nodejs": "https://github.com/hampoelz/capacitor-nodejs/releases/download/v1.0.0-beta.10/capacitor-nodejs.tgz",
    "imapflow": "2.10.0",
    "mailparser": "3.14.1",
    "nodemailer": "10.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "png-to-ico": "2.1.8"
  },
  "build": {
    "appId": "com.dymail.client",
    "productName": "Dymail",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "Dymail-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dymail",
      "uninstallDisplayName": "Dymail",
      "installerLanguages": [
        "zh_CN"
      ],
      "artifactName": "Dymail-Setup-${version}.exe"
    }
  }
}
