{
  "name": "dymail-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Dymail for Android (Capacitor shell around the shared mail core)",
  "scripts": {
    "build": "node scripts/build-www.js",
    "test:bundle": "node scripts/build-www.js && node scripts/test-bundle.js",
    "sync": "node scripts/build-www.js && cap sync android && node scripts/patch-android.js",
    "apk": "node scripts/build-apk.js",
    "android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.3",
    "capacitor-nodejs": "https://github.com/hampoelz/capacitor-nodejs/releases/download/v1.0.0-beta.10/capacitor-nodejs.tgz"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "esbuild": "^0.28.2"
  }
}
